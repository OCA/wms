<odoo>

    <record model="ir.ui.view" id="shopfloor_menu_form_view">
        <field name="model">shopfloor.menu</field>
        <field
            name="inherit_id"
            ref="shopfloor_printing_base.shopfloor_menu_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_print_label_button']" position="after">
                <field name="auto_print_labels_on_location_scan" />
            </xpath>
        </field>
    </record>

</odoo>
