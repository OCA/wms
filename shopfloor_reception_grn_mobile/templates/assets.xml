<odoo>

    <template
        id="shopfloor_app_assets"
        inherit_id="shopfloor_reception_mobile.shopfloor_app_assets"
    >
        <xpath expr="//script[@id='script_scenario_reception_states']" position="after">

          <t
                t-set="mod_version"
                t-value="get_version('shopfloor_reception_grn_mobile')"
            />
          <script
                id="script_reception_grn"
                t-attf-src="/shopfloor_reception_grn_mobile/static/src/scenario/reception_grn.js?v=#{mod_version}"
                type="module"
            />

        </xpath>
    </template>

</odoo>
