<odoo>
    <record id="shopfloor_menu_form_view" model="ir.ui.view">
        <field name="model">shopfloor.menu</field>
        <field name="inherit_id" ref="shopfloor_base.shopfloor_menu_form_view" />
        <field name="arch" type="xml">

            <xpath expr="//group[@name='options']" position="after">
                <group name="print_label" string="Label Printing">
                    <group>
                        <field name="display_print_label_button" />
                    </group>
                    <group>
                        <field name="label_print_report_id" />
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
