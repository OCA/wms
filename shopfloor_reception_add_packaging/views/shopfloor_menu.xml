<odoo>

    <record model="ir.ui.view" id="shopfloor_menu_form_view">
        <field name="model">shopfloor.menu</field>
        <field name="inherit_id" ref="shopfloor_base.shopfloor_menu_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='options']" position="inside">
                <field name="create_new_packaging_is_possible" invisible="1" />
                <group>
                    <field
                        name="create_new_packaging"
                        attrs="{'invisible': [('create_new_packaging_is_possible', '=', False)]}"
                    />
                </group>
            </xpath>
        </field>
    </record>



</odoo>
