<?xml version='1.0' encoding='utf-8' ?>
<odoo>

    <record id="stock_route_form_view" model="ir.ui.view">
        <field name="name">stock service level route: stock.route.form</field>
        <field name="model">stock.route</field>
        <field name="inherit_id" ref="stock.stock_location_route_form_view" />
        <field name="arch" type="xml">
            <field name="warehouse_ids" position="after">
                <field name="service_level_selectable" />
                <field
                    name="service_level_ids"
                    widget="many2many_tags"
                    nolabel="1"
                    invisible="not service_level_selectable"
                />
            </field>
        </field>
    </record>
</odoo>
